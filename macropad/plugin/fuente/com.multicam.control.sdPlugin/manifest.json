{
  "Name": "Multicam",
  "Version": "1.0.0.0",
  "Author": "Multicam",
  "Description": "Controla el switcher Multicam con teclas y diales: cortes, cámaras, VTR, GC, audio y emergencia.",
  "UUID": "com.multicam.control",
  "SDKVersion": 2,
  "Category": "Multicam",
  "CategoryIcon": "imgs/plugin/category",
  "Icon": "imgs/plugin/icon",
  "CodePath": "bin/plugin.js",
  "Nodejs": {
    "Version": "20"
  },
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "Comando Multicam",
      "UUID": "com.multicam.control.comando",
      "Tooltip": "Manda un comando al switcher Multicam (corte, cámara, VTR, emergencia...).",
      "Icon": "imgs/accion/lista",
      "PropertyInspectorPath": "ui/comando.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/accion/tecla",
          "TitleAlignment": "bottom"
        }
      ]
    },
    {
      "Name": "Dial Multicam",
      "UUID": "com.multicam.control.dial",
      "Tooltip": "Rueda: un comando al girar a la derecha, otro a la izquierda y otro al presionar.",
      "Icon": "imgs/accion/lista",
      "PropertyInspectorPath": "ui/dial.html",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "TriggerDescription": {
          "Rotate": "Comando al girar (derecha / izquierda)",
          "Push": "Comando al presionar"
        }
      },
      "States": [
        {
          "Image": "imgs/accion/tecla",
          "TitleAlignment": "bottom"
        }
      ]
    }
  ]
}
